{
  "name": "habit-trackersbiba",
  "version": "1.0.0",
  "description": "Aplikasi desktop pelacak kebiasaan dan konsistensi mandiri.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dev": "nodemon server.js",
    "dist": "electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilhaqschrodinger/Habit-TrackersBiBa.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/bilhaqschrodinger/Habit-TrackersBiBa/issues"
  },
  "homepage": "https://github.com/bilhaqschrodinger/Habit-TrackersBiBa#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.biba.habittracker",
    "productName": "Habit Tracker BiBa",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!dist/**",
      "!*.db",
      "!habittrack.json"
    ]
  }
}
